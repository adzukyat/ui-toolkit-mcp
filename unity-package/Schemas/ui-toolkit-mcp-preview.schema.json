{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-toolkit-mcp-preview:schema:1",
  "title": "UI Toolkit MCP preview configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "previews"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "previews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alias", "document"],
        "properties": {
          "alias": { "type": "string", "minLength": 1 },
          "document": { "type": "string", "minLength": 1 },
          "stylesheets": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "default": []
          },
          "panelSettings": { "type": "string" },
          "selector": { "type": "string" },
          "theme": { "enum": ["editor-dark", "editor-light", "runtime"] },
          "background": {
            "oneOf": [
              { "const": "theme" },
              { "type": "string", "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$" }
            ]
          },
          "viewport": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "width": { "type": "integer", "minimum": 64, "maximum": 16384 },
              "widths": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": { "type": "integer", "minimum": 64, "maximum": 16384 }
              },
              "height": {
                "oneOf": [
                  { "type": "integer", "minimum": 64, "maximum": 16384 },
                  { "const": "full" }
                ]
              }
            }
          },
          "state": {
            "type": "object",
            "propertyNames": { "type": "string", "minLength": 1 },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": { "type": ["string", "number", "integer", "boolean"] },
                "selectedIndex": { "type": "integer", "minimum": -1 },
                "text": { "type": "string" },
                "display": { "type": "boolean" },
                "visible": { "type": "boolean" },
                "enabled": { "type": "boolean" },
                "addClasses": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                },
                "removeClasses": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}
